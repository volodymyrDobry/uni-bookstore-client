# Keycloak authority must use the same host the backend validates the token
# issuer against (keycloak:8080). Add `127.0.0.1 keycloak` to /etc/hosts so the
# browser can resolve it to the published Keycloak port.
VITE_API_URL=http://localhost:8081
VITE_OIDC_AUTHORITY=http://keycloak:8080/realms/uni-book-store
VITE_OIDC_CLIENT_ID=uni-book-store-client
